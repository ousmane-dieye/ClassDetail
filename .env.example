# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-anon
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example-service-role

# --- Email administrateur / SMTP (TAPEZ UNIQUEMENT DES VALEURS RÉELLES EN LOCAL) ---
# Expéditeur unique de TOUS les emails automatiques (doit être autorisé par le fournisseur SMTP).
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=admin@example.com
EMAIL_PASSWORD=change-me-smtp-password
EMAIL_FROM=admin@example.com
EMAIL_FROM_NAME=Administration - ClassPulse

# Repli si SMTP non configuré (optionnel) : conservé pour compatibilité avec l'ancien service Resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=ClassPulse <noreply@example.com>

# --- OpenAI (OPTIONNEL : jamais requis pour l'envoi des emails) ---
# Nécessaire pour l'assistant IA contextuel (boucle d'outils).
# Tout fournisseur compatible OpenAI fonctionne (ex. Google Gemini en free tier).
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# Modèle utilisé par l'assistant (défaut : gpt-4o-mini).
# Pour Gemini : gemini-3.5-flash-lite (recommandé, free tier) ou gemini-3.6-flash.
# (Les modèles 2.5 ne sont plus disponibles pour les nouveaux comptes.)
OPENAI_MODEL=gpt-4o-mini
# Endpoint OpenAI-compatible (défaut : API OpenAI).
# Pour Gemini : https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
OPENAI_BASE_URL=
# Plafond quotidien de questions IA par utilisateur (défaut : 100).
AI_DAILY_LIMIT=100

# --- Identité de la plateforme ---
PLATFORM_NAME=ClassPulse
# URL absolue de l'application — lue CÔTÉ SERVEUR uniquement (Server Actions,
# Route Handlers, composants serveur) : liens d'emails d'authentification,
# confirmations d'inscription et redirections de récupération de mot de passe.
# Local : http://localhost:3000 — Production : https://votre-domaine
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_TIMEZONE=Africa/Dakar
ADMIN_CONTACT_EMAIL=admin@example.com

# Emails autorisés à recevoir un test (virgule = plusieurs). L'email admin (EMAIL_FROM) est toujours autorisé.
EMAIL_TEST_ALLOWLIST=admin@example.com

# --- Vercel Cron ---
CRON_SECRET=change-me-random-secret

# --- Cloudflare Turnstile (Protection CAPTCHA Anti-Bot) ---
# Clé publique pour le widget frontend (optionnel)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Clé secrète pour la validation serveur (optionnel)
TURNSTILE_SECRET_KEY=

